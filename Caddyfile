# HTTPS (Let's Encrypt) is automatic. www is sent to the main address so Google sees one site.
www.kibabucars.com {
	redir https://kibabucars.com{uri} permanent
}

kibabucars.com {
	encode zstd gzip
	request_body {
		max_size 13MB
	}
	reverse_proxy app:4000
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
