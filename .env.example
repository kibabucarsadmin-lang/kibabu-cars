# Server settings. On Cloudways Velocity, add these under Environment Variables (mark secrets as "Sensitive").
# Locally: copy to .env and fill in. Never commit .env.

NODE_ENV=production
# The hosting sets PORT itself; 4000 is only the local default
PORT=4000
SITE_URL=https://kibabucars.com
# Requests for any other host name (www., server IP, test domain) are redirected here.
# Leave EMPTY while you test on the hosting's temporary domain; set it when kibabucars.com points to the new server.
CANONICAL_HOST=
# Extra host names the site may answer on, comma separated. Put the hosting's temporary domain here while testing.
ALLOWED_HOSTS=
# Set to true only if no proxy (Cloudflare/Caddy/Nginx) handles HTTPS redirects
FORCE_HTTPS=false
# Behind Cloudflare (Cloudways Velocity is): use the visitor's real IP for rate limits
BEHIND_CLOUDFLARE=true

# ---------- Database: PostgreSQL or MySQL/MariaDB ----------
# One line is enough:
#   PostgreSQL: DATABASE_URL=postgres://user:password@host:5432/dbname   (add ?sslmode=require for hosted databases)
#   MySQL:      DATABASE_URL=mysql://user:password@host:3306/dbname
# Or the separate values below (DB_CLIENT=postgres or mysql; port 5432 also means PostgreSQL).
# PostgreSQL's own PGHOST / PGUSER / PGPASSWORD / PGDATABASE / PGPORT are understood too.
# With no database set, data is kept in a JSON file in DATA_DIR (fine for local testing only).
DATABASE_URL=
DB_CLIENT=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# TLS to the database: true / false (default: on when the URL says sslmode=require)
DB_SSL=

# Local safety copy of the data + daily JSON backups
DATA_DIR=./data
BACKUP_KEEP_DAYS=14

# ---------- Admin ----------
# At least 12 characters. The server will not start in production without these two.
ADMIN_PASSWORD=
# Random secret (also encrypts the Resend key saved in the admin):  openssl rand -hex 32
# Keep it the same forever; if it changes, paste the Resend key in the admin again.
ADMIN_SECRET=

# ---------- Emails (Resend) ----------
# Easiest: leave empty and paste the key in Admin → Email & database.
# Emails are always sent from "Kibabu Cars Zanzibar <info@kibabucars.com>", so kibabucars.com must be verified in Resend.
RESEND_API_KEY=
# Where new-booking alerts go (can also be changed in the admin)
OWNER_EMAIL=info@kibabucars.com

# Optional fallback if you ever prefer plain SMTP instead of Resend
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
